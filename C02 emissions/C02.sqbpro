</sql><sql name="C02QUERIES.sql">SELECT C02.YEAR, C02.STATE, SECTOR, EMISSIONS, POPULATION 
	FROM C02 INNER JOIN Pop
	ON C02.YEAR = Pop.YEAR
	AND C02.STATE =Pop.STATE
;</sql><current_tab id="1"/></tab_sql></sqlb_project>
