<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/mlee9/Desktop/SQLiteDatabaseBrowserPortable/nj-hiv-pop-prep.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="125"/><column_width id="3" width="1475"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,4:mainPrEP"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="HIV" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="55"/><column index="2" value="95"/><column index="3" value="114"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="POP" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="55"/><column index="2" value="95"/><column index="3" value="124"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="PrEP" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="55"/><column index="2" value="95"/><column index="3" value="67"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="queries.sql">SELECT HIV.YEAR, HIV.COUNTY, DIAGNOSES, POPULATION, USERS
	FROM HIV INNER JOIN POP
	ON HIV.COUNTY = POP.COUNTY AND HIV.YEAR = POP.YEAR
	INNER JOIN PrEP
	ON HIV.COUNTY = PrEP.COUNTY AND HIV.YEAR = PrEP.YEAR
;
	
--multiply by 1.0 to show decimal. FLOAT
SELECT POP.YEAR, SUM(POPULATION) as population,
	SUM(DIAGNOSES) as diagnoses,
	100000.0*SUM(DIAGNOSES)/sum(POPULATION) as incidenceRate,
	100000.0*sum(USERS)/sum(population) as prepRate,
	1.0*SUM(USERS)/SUM(DIAGNOSES) AS pnr
	FROM POP LEFT JOIN HIV
	ON HIV.COUNTY = POP.COUNTY AND HIV.YEAR = POP.YEAR
	LEFT JOIN PrEP
	ON HIV.COUNTY = PrEP.COUNTY AND HIV.YEAR = PrEP.YEAR
	GROUP BY POP.YEAR
;

--*100k</sql><sql name="schema.sql">DROP TABLE IF EXISTS HIV;																				
